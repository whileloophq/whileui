{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Browser globals: these specs run `document` code inside the page via `evaluate`.
    // `DOM.Iterable` so spreading a NodeList in page code typechecks.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["**/*.ts"]
}
