# Dependencies
node_modules/

# Build
dist/
.turbo/

# Expo
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Metro
.metro-health-check*

# iOS
ios/Pods/
*.xcworkspace
*.xcuserdata

# Android
android/.gradle/
android/app/build/
*.apk
*.aab

# Environment — broad on purpose. `.env` and `.env.*.local` alone left
# `.env.production` and `.env.staging` tracked, which is the one way a real key
# reaches a public repo from here.
.env
.env.*
!.env.example

# Internal (not for public repo)
DEPLOY.md
TODO.md
CONSUMERS.md
.delta/

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Uniwind
uniwind-types.d.ts

# Copied in by prepack, removed by postpack — never tracked
packages/ui/README.md

# `npm pack` writes the tarball where you run it, and docs/stability.md tells you
# to run it in packages/ui to reproduce the baseline. verify:package packs to a
# temp dir; a hand-run does not.
*.tgz

# Coverage
coverage/

# Playwright
test-results/
playwright-report/

# Generated native projects (managed workflow — `expo prebuild` recreates them)
apps/*/ios/
apps/*/android/
