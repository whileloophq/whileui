{
  "name": "@whileui/showcase",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --port 8082",
    "dev": "expo start --port 8082",
    "android": "expo start --android --port 8082",
    "ios": "expo start --ios --port 8082",
    "web": "expo start --web --port 8082",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "serve:web": "expo serve --port 8083",
    "build:native": "expo export --platform ios && expo export --platform android",
    "build:native-app": "expo run:android --no-bundler"
  },
  "dependencies": {
    "@expo-google-fonts/inter-tight": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@rn-primitives/hooks": "1.5.2",
    "@rn-primitives/hover-card": "1.5.2",
    "@rn-primitives/popover": "1.5.2",
    "@rn-primitives/portal": "1.5.3",
    "@rn-primitives/select": "1.5.2",
    "@rn-primitives/slot": "1.5.2",
    "@rn-primitives/tooltip": "1.5.2",
    "@thewhileloop/whileui": "workspace:*",
    "expo": "~58.0.14",
    "expo-blur": "~58.0.4",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.2"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
