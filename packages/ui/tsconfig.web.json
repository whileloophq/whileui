{
  // DOM track. Needs the DOM lib; the main tsconfig resolves globals from React
  // Native's types and adding DOM there collides with RN's fetch/FormData.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/web/**/*"],
  // Tests are run by vitest from source; they must not reach the package.
  "exclude": ["node_modules", "dist", "src/web/**/*.test.ts", "src/web/**/*.test.tsx"]
}
