{
  // DOM track. Needs the DOM lib; the main tsconfig resolves globals from React
  // Native's types and adding DOM there collides with RN's fetch/FormData.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/web/**/*"],
  "exclude": ["node_modules", "dist"]
}
