{
  "name": "@thewhileloop/whileui",
  "version": "4.0.0",
  "description": "WhileUI Native — Copy-paste components for React Native. You own the code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whileloophq/whileui.git"
  },
  "keywords": [
    "react-native",
    "expo",
    "ui",
    "components",
    "tailwind",
    "uniwind"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./blocks/*": {
      "types": "./dist/blocks/*/index.d.ts",
      "import": "./dist/blocks/*/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "cp ../../README.md README.md",
    "postpack": "rm -f README.md",
    "prepare": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "peerDependencies": {
    "@rn-primitives/hooks": ">=1.5.2",
    "@rn-primitives/hover-card": ">=1.5.2",
    "@rn-primitives/popover": ">=1.5.2",
    "@rn-primitives/portal": ">=1.5.3",
    "@rn-primitives/select": ">=1.5.2",
    "@rn-primitives/slot": ">=1.5.2",
    "@rn-primitives/tooltip": ">=1.5.2",
    "expo": ">=58.0.0",
    "expo-blur": ">=58.0.0",
    "expo-image": ">=58.0.0",
    "react": ">=19.3.0",
    "react-native": ">=0.88.0",
    "react-native-gesture-handler": ">=3.3.0",
    "react-native-reanimated": ">=4.7.0",
    "react-native-safe-area-context": ">=5.10.0",
    "react-native-screens": ">=4.30.0",
    "tailwindcss": ">=4.0.0",
    "uniwind": ">=1.12.0",
    "react-native-worklets": ">=0.13.0"
  },
  "peerDependenciesMeta": {
    "expo-blur": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "culori": "^4.0.2",
    "react-native-calendars": "^1.1314.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/culori": "^4.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "expo-image": "~58.0.15",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.11",
    "react-native-screens": "~4.30.0",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
