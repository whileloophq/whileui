{
  "name": "@thewhileloop/whileui-mcp",
  "version": "0.1.0",
  "description": "MCP server that gives AI agents the docs and theme tokens of the WhileUI version installed in your project.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whileloophq/whileui.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "whileui",
    "react-native"
  ],
  "type": "module",
  "bin": {
    "whileui-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@thewhileloop/whileui": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3"
  }
}
